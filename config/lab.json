{
  "budget": {
    "daily_usd": 1.5,
    "bank_cap_usd": 10,
    "light_run_max_usd": 3,
    "deep_run_threshold_usd": 6,
    "deep_run_max_usd": 6,
    "min_run_usd": 0.1
  },
  "models": {
    "light": "claude-sonnet-5-5",
    "deep": "claude-opus-5-5"
  },
  "publish": {
    "max_notes_per_day": 15,
    "min_notes_per_day": 5,
    "name_pattern": "^lab-\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$",
    "max_claims_per_night": 4,
    "max_claim_chars": 1000,
    "max_paradigm_chars": 1500
  },
  "kinocomputing": {
    "origin": "https://www.kinocomputing.com/",
    "repo": "msmsim/kinocomputing"
  },
  "search": {
    "exa_usd_per_night": 0.5,
    "exa_share": 0.33,
    "agent_usd": {
      "minimal": 0.012,
      "low": 0.025,
      "medium": 0.1
    },
    "watch_per_question": 3,
    "feeds": [
      {
        "name": "arXiv: Emerging Technologies (unconventional computing)",
        "source": "arxiv",
        "query": "cat:cs.ET",
        "n": 5
      },
      {
        "name": "bioRxiv and other preprints: biological computing",
        "source": "europepmc",
        "query": "(\"organoid intelligence\" OR \"basal cognition\" OR \"DNA computing\" OR \"molecular computing\" OR \"physarum\" OR \"biohybrid computing\" OR (\"cultured neurons\" AND computing) OR (\"organoid\" AND \"reservoir computing\")) AND SRC:PPR",
        "n": 3
      }
    ],
    "chatter_per_night": 8
  },
  "lab": {
    "repo": "msmsim/kinocomputing-lab",
    "evidence_base": "https://github.com/msmsim/kinocomputing-lab/blob/main/"
  },
  "shift": {
    "minutes": 60,
    "experiment_seconds": 600
  },
  "paradigms": {
    "cycle_days": 14
  },
  "shifts": {
    "per_day": 2,
    "first_share": 0.4
  },
